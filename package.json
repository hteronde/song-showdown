{
  "name": "song-showdown",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --proxy-config proxy.conf.json",
    "start:api": "node --watch --env-file-if-exists=.env server/index.mjs",
    "test:api": "node --test server/*.test.mjs",
    "test:integration": "node --env-file-if-exists=.env scripts/run-http-integration.mjs",
    "profile:bracket": "node scripts/profile-bracket-rendering.mjs",
    "build": "ng build"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.2.0",
    "mysql2": "^3.14.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "typescript": "~6.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
